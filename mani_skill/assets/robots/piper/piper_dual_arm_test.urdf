    <inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.01 0.01 0.01"/>
    </geometry>
    <material name="camera_color">
      <color rgba="0 0 1 1"/>
    </material>
  </visual>
</link>

<joint name="right_camera_joint" type="fixed">
  <origin xyz="0.0 0.08 -0.0" rpy="0.5 3.14 0"/>
  <parent link="right_link6"/>
  <child link="right_camera_link"/>
</joint>

  <!-- 固定关节连接基座到左右臂 -->
  <joint name="base_to_left_base" type="fixed">
    <origin xyz="0.234 0.303 0.761" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_base_link"/>
  </joint>

  <joint name="base_to_right_base" type="fixed">
    <origin xyz="0.234 -0.303 0.761" rpy="0 0 0"/>
