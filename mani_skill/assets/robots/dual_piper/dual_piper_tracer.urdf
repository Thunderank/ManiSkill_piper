    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/tracer_wheel.dae"/>
      </geometry>
    </visual>
  </link>
  <joint name="right_wheel" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin rpy="0 0 0" xyz="0 -0.17 -0.082"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="left_wheel_link">
    <inertial>
      <mass value="6"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.717" ixy="0" ixz="0" iyy="0.136" iyz="0" izz="0.717"/>
