      <origin rpy="0 0 0" xyz="0.00065123185041968 -0.0491929869131989 0.00972258769184025"/>
      <mass value="0.025"/>
      <inertia ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021" iyy="0.00000781" iyz="-0.00001372" izz="0.0000747"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://meshes/link7.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://meshes/link7.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_arm_joint7" type="prismatic">
    <origin rpy="1.5708 0 0" xyz="0 0 0.1358"/>
    <parent link="right_arm_gripper_base"/>
    <child link="right_arm_link7"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" lower="0" upper="0.035" velocity="1"/>
  </joint>
  <link name="right_arm_link8">
    <inertial>
      <origin rpy="0 0 0" xyz="0.000651231850419722 -0.0491929869131991 0.00972258769184024"/>
      <mass value="0.025"/>
      <inertia ixx="0.00007371" ixy="-0.00000113" ixz="0.00000021" iyy="0.00000781" iyz="-0.00001372" izz="0.0000747"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://meshes/link8.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://meshes/link8.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_arm_joint8" type="prismatic">
    <origin rpy="1.5708 0 -3.1416" xyz="0 0 0.1358"/>
    <parent link="right_arm_gripper_base"/>
    <child link="right_arm_link8"/>
    <axis xyz="0 0 -1"/>
    <limit effort="100" lower="-0.035" upper="0" velocity="1"/>
  </joint>
  <joint name="right_arm_to_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_arm_base_link"/>
    <origin rpy="0 0 0" xyz="0.2 -0.25 0.63"/>
  </joint>
  <!-- ================ 虚拟底座关节  ================ -->
  <!-- 对于旋转关节（revolute/continuous），设置axis xyz 100代表绕x轴旋转，010y轴，001z轴 -->
  <!-- 对于移动关节（prismatic）：axis xyz="1 0 0" 表示沿X轴平移 axis xyz="0 1 0" 表示沿Y轴平移 axis xyz="0 0 1" 表示沿Z轴平移 -->
  <link name="root">
    <inertial>
      <mass value="0"/>
      <inertia ixx="0.00" ixy="0.00" ixz="0.00" iyy="0.00" iyz="0.00" izz="0.00"/>
    </inertial>
  </link>
  <link name="root_arm_1_link_1">
    <inertial>
      <mass value="0"/>
      <inertia ixx="0.00" ixy="0.00" ixz="0.00" iyy="0.00" iyz="0.00" izz="0.00"/>
    </inertial>
  </link>
  <link name="root_arm_1_link_2">
    <inertial>
      <mass value="0"/>
      <inertia ixx="0.00" ixy="0.00" ixz="0.00" iyy="0.00" iyz="0.00" izz="0.00"/>
    </inertial>
  </link>
  <joint name="root_x_axis_joint" type="prismatic">
    <parent link="root"/>
    <child link="root_arm_1_link_1"/>
    <axis xyz="1 0 0"/>
    <limit effort="100" lower="-20" upper="20" velocity="0.50"/>
    <dynamics damping="10.0" friction="10"/>
  </joint>
  <joint name="root_y_axis_joint" type="prismatic">
    <parent link="root_arm_1_link_1"/>
    <child link="root_arm_1_link_2"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="-20" upper="20" velocity="0.50"/>
    <dynamics damping="10.0" friction="10"/>
  </joint>
  <!-- 后续恢复z轴的旋转属性和绑定的link -->
  <!-- <joint name="root_z_rotation_joint" type="continuous">
    <parent link="root_arm_1_link_2"/>
    <child link="base_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="10.0" friction="1"/>
  </joint> -->
  <!-- 将基座改写为固定，先修改抓取任务逻辑 -->
  <joint name="root_z_rotation_joint" type="fixed">
    <parent link="root"/>
    <child link="base_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="10.0" friction="1"/>
  </joint>
  <!-- ================ 移动底盘 ================ -->
