      <geometry>
        <mesh filename="meshes/tracer_base_link.STL"/>
      </geometry>
    </collision>
  </link> -->
  <!-- 纠正后的tracer底盘 -->
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/corrected_tracer_base_link.glb"/>
      </geometry>
      <material name="grey"/>
