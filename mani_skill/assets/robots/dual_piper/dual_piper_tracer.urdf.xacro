  </joint>

  <link name="right_camera">
    <visual>
      <origin xyz="0 -0.032 0" rpy="3.14 3.14 1.57"/>
      <geometry>
        <mesh filename="meshes/d435.dae"/>
      </geometry>
      <material name="black"/>
    </visual>
