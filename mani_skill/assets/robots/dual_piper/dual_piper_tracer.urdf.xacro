      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="right_camera_joint" type="fixed">
    <parent link="right_arm_gripper_base"/>
    <child link="right_camera"/>
    <origin xyz="0.07 0.032 0.065" rpy="0 0.4 0"/>
  </joint> -->

<!-- 使用大白相机 -->
  <link name="left_arm_camera">
    <visual>
      <origin xyz="-0.05 0 0.03" rpy="0 3.14159265358 1.57079632679"/>
      <geometry>
        <mesh filename="meshes/dabai.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="left_arm_camera_joint" type="fixed">
    <parent link="left_arm_gripper_base"/>
    <child link="left_arm_camera"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="right_arm_camera">
    <visual>
      <origin xyz="-0.05 0 0.03" rpy="0 3.14159265358 1.57079632679"/>
      <geometry>
        <mesh filename="meshes/dabai.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="right_arm_camera_joint" type="fixed">
    <parent link="right_arm_gripper_base"/>
    <child link="right_arm_camera"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <link name="global_camera_link"/>
  <joint name="global_camera_joint" type="fixed">
    <parent link="root"/>
    <child link="global_camera_link"/>
    <origin xyz="0 0.0 1.0" rpy="0 0 0"/>
  </joint>
</robot>